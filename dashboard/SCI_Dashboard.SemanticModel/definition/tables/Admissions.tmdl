	column 'Post-op meds cost' =
			
			VAR ActualSurgeries = CALCULATE ( COUNTROWS ( Surgery ), Surgery[Surgery status] = "Actual" )
			VAR MedsFee =
			    LOOKUPVALUE ( FeeLookup[Fee], FeeLookup[Code], "MELOXICAM" )
			        + LOOKUPVALUE ( FeeLookup[Fee], FeeLookup[Code], "PARACETAMOL_CODEINE" )
			RETURN
			    IF ( ActualSurgeries > 0, MedsFee, 0 )
		lineageTag: a89fc06f-4cae-49a6-aa74-6df257b6abb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Potential post-op meds cost' =
			
			VAR ActualSurgeries = CALCULATE ( COUNTROWS ( Surgery ), Surgery[Surgery status] = "Actual" )
			VAR PlannedSurgeries = CALCULATE ( COUNTROWS ( Surgery ), Surgery[Surgery status] = "Planned" )
			VAR MedsFee =
			    LOOKUPVALUE ( FeeLookup[Fee], FeeLookup[Code], "MELOXICAM" )
			        + LOOKUPVALUE ( FeeLookup[Fee], FeeLookup[Code], "PARACETAMOL_CODEINE" )
			RETURN
			    IF ( ActualSurgeries = 0 && PlannedSurgeries > 0, MedsFee, 0 )
		lineageTag: 341449f3-7697-4455-ac4c-9d9bc1644f9f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Age group' = SWITCH ( TRUE (), Admissions[adm_age] < 60, "Under 60 (reference)", Admissions[adm_age] < 70, "60-69", Admissions[adm_age] < 80, "70-79", "80+" )
		lineageTag: 8d121926-303b-4cff-ada4-5fc57715cfc9
		summarizeBy: none
		sortByColumn: 'Age group order'

	column 'Age group order' = SWITCH ( TRUE (), Admissions[adm_age] < 60, 1, Admissions[adm_age] < 70, 2, Admissions[adm_age] < 80, 3, 4 )
		formatString: 0
		lineageTag: 72a8f44d-2121-45cf-b148-5d537c051c2f
		summarizeBy: none

	column 'Had surgery' =
			IF (
			    NOT Admissions[Single-admission patient],
			    "Unknown (multi-admission)",
			    IF ( CALCULATE ( COUNTROWS ( Surgery ), Surgery[Surgery status] = "Actual" ) > 0, "Yes", "No" )
			)
		lineageTag: dd043284-2e44-4551-b02e-9efff6331304
		summarizeBy: none

	partition Admissions = m
		mode: import
		source =
				let
				    Source = REDCap_Raw,
				    Rows = Table.SelectRows(Source, each [redcap_repeat_instrument] = "admissions"),
				    Keep = Table.SelectColumns(Rows, {"patient_id", "redcap_repeat_instance", "adm_doa", "adm_dos", "adm_age", "adm_los", "adm_mode_sep", "adm_ed_status", "adm_icu_hrs", "adm_mv_hrs", "adm_cci", "adm_hfrs"}),
				    Typed = Table.TransformColumnTypes(Keep, {{"redcap_repeat_instance", Int64.Type}, {"adm_doa", type date}, {"adm_dos", type date}, {"adm_age", type number}, {"adm_los", Int64.Type}, {"adm_icu_hrs", type number}, {"adm_mv_hrs", type number}, {"adm_cci", type number}, {"adm_hfrs", type number}}),
				    Key = Table.AddColumn(Typed, "AdmissionKey", each [patient_id] & "-" & Text.From([redcap_repeat_instance]), type text),
				    Year = Table.AddColumn(Key, "Admission year", each Date.Year([adm_doa]), Int64.Type),
				    Is60 = Table.AddColumn(Year, "Is 60+", each [adm_age] >= 60, type logical),
				    AgeBand = Table.AddColumn(Is60, "Age band", each if [adm_age] < 60 then "Under 60" else if [adm_age] < 75 then "60-74" else "75+", type text),
				    HFRS = Table.AddColumn(AgeBand, "HFRS band", each if [adm_hfrs] = null then "Not recorded" else if [adm_hfrs] < 5 then "Low (<5)" else if [adm_hfrs] <= 15 then "Intermediate (5-15)" else "High (>15)", type text),
				    Died = Table.AddColumn(HFRS, "Died in hospital", each if Text.StartsWith([adm_mode_sep], "IP Died") then 1 else 0, Int64.Type),
				    ICUDays = Table.AddColumn(Died, "ICU days", each if [adm_icu_hrs] = null then null else Number.RoundUp([adm_icu_hrs] / 24), Int64.Type),
				    ICUFirstDayFee = FeeLookup{[Code = "13870"]}[Fee],
				    ICULaterDayFee = FeeLookup{[Code = "13873"]}[Fee],
				    BloodTestFee = FeeLookup{[Code = "65060"]}[Fee],
				    ICUCost = Table.AddColumn(ICUDays, "ICU cost", each if [ICU days] = null then null else if [ICU days] = 0 then 0 else ICUFirstDayFee + ([ICU days] - 1) * ICULaterDayFee, type number),
				    BloodCost = Table.AddColumn(ICUCost, "Blood test cost", each BloodTestFee, type number),
				    Counts = Table.Group(BloodCost, {"patient_id"}, {{"Admissions per patient", each Table.RowCount(_), Int64.Type}}),
				    Joined = Table.NestedJoin(BloodCost, {"patient_id"}, Counts, {"patient_id"}, "C", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "C", {"Admissions per patient"}),
				    Single = Table.AddColumn(Expanded, "Single-admission patient", each [Admissions per patient] = 1, type logical)
				in
				    Single

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

