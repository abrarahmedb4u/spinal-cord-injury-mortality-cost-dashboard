table Admissions
	lineageTag: 747af5fc-5c28-46d9-a1de-c9b6dae2eb9a

	measure 'Admissions (n)' = COUNTROWS ( Admissions )
		formatString: #,0
		lineageTag: 26b49a11-e33f-49df-aaaf-80e78a81a3fb

	measure 'Patients (n)' = DISTINCTCOUNT ( Admissions[patient_id] )
		formatString: #,0
		lineageTag: 5d7801fe-b495-4657-bd7f-9f8d2d58ef60

	measure 'Deaths (n)' = SUM ( Admissions[Died in hospital] )
		formatString: 0
		lineageTag: 395f0a64-2c2c-4754-960b-af4872ddd7f7

	measure 'In-hospital mortality %' = DIVIDE ( [Deaths (n)], [Admissions (n)] )
		formatString: 0.00%
		lineageTag: d73a6c27-e8d1-4d88-9891-7c7d4af0f851

	measure 'Mortality CI lower %' =
			VAR n = [Admissions (n)]
			VAR p = DIVIDE ( [Deaths (n)], n )
			VAR z = 1.96
			VAR denom = 1 + z ^ 2 / n
			VAR centre = ( p + z ^ 2 / ( 2 * n ) ) / denom
			VAR half = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / denom
			RETURN IF ( n = 0, BLANK (), MAX ( 0, centre - half ) )
		formatString: 0.00%
		lineageTag: e4cc70e1-1d8f-4854-ae05-579083839b0e

	measure 'Mortality CI upper %' =
			VAR n = [Admissions (n)]
			VAR p = DIVIDE ( [Deaths (n)], n )
			VAR z = 1.96
			VAR denom = 1 + z ^ 2 / n
			VAR centre = ( p + z ^ 2 / ( 2 * n ) ) / denom
			VAR half = z * SQRT ( p * ( 1 - p ) / n + z ^ 2 / ( 4 * n ^ 2 ) ) / denom
			RETURN IF ( n = 0, BLANK (), MIN ( 1, centre + half ) )
		formatString: 0.00%
		lineageTag: 1428e67e-8c53-425e-a22e-32cd96245027

	measure 'Median length of stay (days)' = MEDIAN ( Admissions[adm_los] )
		formatString: 0
		lineageTag: 27b4a93e-6640-4fdf-99b9-57c5e78386b0

	measure 'Blood tests switch' = SELECTEDVALUE ( BloodTestSwitch[Include blood tests], "No" )
		lineageTag: 77b8f901-4389-4393-8b33-fcf4cf2220b6

	measure 'Total ICU cost' = SUM ( Admissions[ICU cost] )
		formatString: \$#,0
		lineageTag: 38a1dd4d-2409-4a66-9588-fe780578b579

	measure 'Total blood test cost' = IF ( [Blood tests switch] = "Yes", SUM ( Admissions[Blood test cost] ), 0 )
		formatString: \$#,0
		lineageTag: 9174adcc-6261-43f4-a7b0-4f00b3bf4820

	measure 'Total surgery cost' =
			IF (
			    [Surgery discount switch] = "Yes",
			    CALCULATE ( SUM ( Surgery[Surgery fee (same-day discount)] ), Surgery[Surgery status] = "Actual" ),
			    CALCULATE ( SUM ( Surgery[Surgery fee] ), Surgery[Surgery status] = "Actual" )
			)
		formatString: \$#,0
		lineageTag: 0f901083-05a3-448a-8df0-13c23d150659

	measure 'Total post-op meds cost' = SUM ( Admissions[Post-op meds cost] )
		formatString: \$#,0
		lineageTag: 599ca351-5374-47d9-8506-94ba713b5004

	measure 'Total cost (fee-based)' = [Total ICU cost] + [Total surgery cost] + [Total post-op meds cost] + [Total blood test cost]
		formatString: \$#,0
		lineageTag: 9bf3ce67-667b-4640-9c49-002c33c48235

	measure 'Average cost per admission' = DIVIDE ( [Total cost (fee-based)], [Admissions (n)] )
		formatString: \$#,0
		lineageTag: ce54ea98-754b-409d-8066-277bc5ccaab4

	measure 'Potential cost of planned surgery' =
			IF (
			    [Surgery discount switch] = "Yes",
			    CALCULATE ( SUM ( Surgery[Surgery fee (same-day discount)] ), Surgery[Surgery status] = "Planned" ),
			    CALCULATE ( SUM ( Surgery[Surgery fee] ), Surgery[Surgery status] = "Planned" )
			)
			    + SUM ( Admissions[Potential post-op meds cost] )
		formatString: \$#,0
		lineageTag: 1ca663b7-5faa-4190-8936-027e34cbe375

	measure 'Total cost by DRG' = CALCULATE ( [Total cost (fee-based)], CROSSFILTER ( DRG[AdmissionKey], Admissions[AdmissionKey], BOTH ) )
		formatString: \$#,0
		lineageTag: 4c26af16-c549-4b7c-bcec-b4cfe2b38f8d

	measure 'Admissions by DRG (n)' = CALCULATE ( [Admissions (n)], CROSSFILTER ( DRG[AdmissionKey], Admissions[AdmissionKey], BOTH ) )
		formatString: #,0
		lineageTag: 01b356c8-db55-4457-9261-84b2296c0ef2

	measure 'Top 5 DRG cost' =
			VAR r = RANKX ( ALLSELECTED ( DRG[drg_description] ), [Total cost by DRG], , DESC )
			RETURN IF ( r <= 5, [Total cost by DRG] )
		formatString: \$#,0
		lineageTag: d68f8197-266c-411c-be7f-1d81b4fab03a

	measure 'Top 5 operation cost' =
			VAR r = RANKX ( ALLSELECTED ( Surgery[surg_op_description] ), [Total surgery cost], , DESC )
			RETURN IF ( r <= 5 && [Total surgery cost] > 0, [Total surgery cost] )
		formatString: \$#,0
		lineageTag: 6602263d-f8eb-453c-a76d-84c59491565a

	measure 'Admissions with code (n)' = CALCULATE ( DISTINCTCOUNT ( ICD[AdmissionKey] ), NOT ISBLANK ( ICD[AdmissionKey] ) )
		formatString: 0
		lineageTag: 9e2cbe1d-f04c-410c-b78c-7375a0027349

	measure 'Death admissions (n)' = CALCULATE ( [Admissions with code (n)], Admissions[Died in hospital] = 1 )
		formatString: 0
		lineageTag: 2861c549-d26c-4456-9357-f28c132fed97

	measure 'Records by death source' =
			SWITCH (
			    SELECTEDVALUE ( 'Death source'[Source] ),
			    "Mode of separation is IP Died", [Deaths (n)],
			    "Patient has a deceased date", COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( RELATED ( Patients[date_deceased] ) ) ) ),
			    "Deceased date is the 10 Sep 2026 default", COUNTROWS ( FILTER ( Admissions, RELATED ( Patients[date_deceased] ) = DATE ( 2026, 9, 10 ) ) )
			)
		formatString: 0
		lineageTag: c5f6ddaf-709c-444e-a27c-625b70a59443

	measure 'Filled %' =
			VAR n = [Admissions (n)]
			VAR single = COUNTROWS ( FILTER ( Admissions, Admissions[Single-admission patient] ) )
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( 'Completeness field'[Field] ),
			        "ICU hours", DIVIDE ( COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_icu_hrs] ) ) ), n ),
			        "Ventilation hours", DIVIDE ( COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_mv_hrs] ) ) ), n ),
			        "Admitted to ED", DIVIDE ( COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_ed_status] ) ) ), n ),
			        "Charlson (CCI)", DIVIDE ( COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_cci] ) ) ), n ),
			        "Frailty (HFRS)", DIVIDE ( COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_hfrs] ) ) ), n ),
			        "Funding (public/private)", DIVIDE ( COUNTROWS ( FILTER ( Admissions, RELATED ( Patients[Funding] ) <> "Not recorded" ) ), n ),
			        "ICD-10 code*", DIVIDE ( COUNTROWS ( FILTER ( Admissions, Admissions[Single-admission patient] && NOT ISEMPTY ( RELATEDTABLE ( ICD ) ) ) ), single ),
			        "DRG*", DIVIDE ( COUNTROWS ( FILTER ( Admissions, Admissions[Single-admission patient] && NOT ISEMPTY ( RELATEDTABLE ( DRG ) ) ) ), single ),
			        "ASIA grade", 0,
			        "Spinal Trauma Score", 0
			    )
		formatString: 0.0%
		lineageTag: 7579ef58-9ee6-4f14-b5d2-b4e2bb40d967

	measure 'Surgery discount switch' = SELECTEDVALUE ( SurgeryDiscountSwitch[Apply same-day discount], "No" )
		lineageTag: a4c71543-86bf-4683-b99c-65a9442e6f61

	measure 'Average length of stay (days)' = AVERAGE ( Admissions[adm_los] )
		formatString: 0.0
		lineageTag: cc2a7be6-150c-4df8-8dc6-3efa250395b5

	measure Bed-days = SUM ( Admissions[adm_los] )
		formatString: #,0
		lineageTag: da73124b-af2f-4570-80dd-2a063861efd3

	measure '% with surgery' =
			DIVIDE (
			    COUNTROWS ( FILTER ( Admissions, Admissions[Had surgery] = "Yes" ) ),
			    COUNTROWS ( FILTER ( Admissions, Admissions[Had surgery] <> "Unknown (multi-admission)" ) )
			)
		formatString: 0.0%
		lineageTag: e07b18df-1148-49b3-b4a7-144ae5203f8b

	measure '% with ICU stay' =
			DIVIDE (
			    COUNTROWS ( FILTER ( Admissions, Admissions[ICU cost] > 0 ) ),
			    COUNTROWS ( FILTER ( Admissions, NOT ISBLANK ( Admissions[adm_icu_hrs] ) ) )
			)
		formatString: 0.0%
		lineageTag: f8057350-7db6-4fa6-aa1b-6fcf034955e3

	measure 'Headline mortality' =
			VAR d = [Deaths (n)]
			VAR n = [Admissions (n)]
			RETURN
			    "In-hospital mortality is " & FORMAT ( [In-hospital mortality %], "0.0%" ) & " (" & FORMAT ( d, "0" ) & " deaths in "
			        & FORMAT ( n, "#,0" ) & " admissions). With so few deaths, differences between groups are not reliable: read the 95% confidence interval."
		lineageTag: 9e0721ce-69bb-43f1-997c-9f51c55032cf

	measure 'Headline age' = ```
			
			        VAR m1 = CALCULATE ( [In-hospital mortality %], Admissions[Age group] = "60-69" )
			        VAR m2 = CALCULATE ( [In-hospital mortality %], Admissions[Age group] = "70-79" )
			        VAR m3 = CALCULATE ( [In-hospital mortality %], Admissions[Age group] = "80+" )
			        VAR tbl = FILTER ( ADDCOLUMNS ( VALUES ( Admissions[Age group] ), "@cost", [Average cost per admission], "@stay", [Average length of stay (days)] ), Admissions[Age group] <> "Under 60 (reference)" )
			        VAR pattern =
			            IF ( m1 < m2 && m2 < m3, "rises with each age group",
			                IF ( m1 > m2 && m2 > m3, "falls with each age group", "shows no steady rise with age" ) )
			        RETURN
			            "Aged 60+: mortality " & pattern & " (" & FORMAT ( m1, "0.0%" ) & ", " & FORMAT ( m2, "0.0%" ) & ", " & FORMAT ( m3, "0.0%" )
			                & "). Average cost per admission ranges $" & FORMAT ( MINX ( tbl, [@cost] ), "#,0" ) & " to $" & FORMAT ( MAXX ( tbl, [@cost] ), "#,0" )
			                & " and average stay " & FORMAT ( MINX ( tbl, [@stay] ), "0.0" ) & " to " & FORMAT ( MAXX ( tbl, [@stay] ), "0.0" ) & " days. Under 60 is shown for comparison only."
			```
		lineageTag: 50116a1b-de47-4132-becc-d33a0087a280

	measure 'Headline deaths' =
			VAR d = [Deaths (n)]
			VAR coded = [Death admissions (n)]
			VAR topg =
			    MAXX ( TOPN ( 1, FILTER ( VALUES ( ICD[Condition group] ), [Death admissions (n)] > 0 ), [Death admissions (n)], DESC ), ICD[Condition group] )
			RETURN
			    FORMAT ( d, "0" ) & " admissions ended in death; " & FORMAT ( coded + 0, "0" ) & " of them have an ICD-10 code"
			        & IF ( NOT ISBLANK ( topg ), ", most often " & LOWER ( topg ), "" )
			        & ". A code shows a condition was recorded, not the cause of death."
		lineageTag: c2050806-0f91-415c-aa58-2b9442ff961f

	measure 'Headline cost' =
			VAR tot = [Total cost (fee-based)]
			RETURN
			    "Fee-based cost is $" & FORMAT ( tot, "#,0" ) & " ($" & FORMAT ( [Average cost per admission], "#,0" ) & " per admission). Surgery fees are "
			        & FORMAT ( DIVIDE ( [Total surgery cost], tot ), "0%" ) & " of it. The " & FORMAT ( [Bed-days], "#,0" )
			        & " bed-days are not costed, so the real cost of care is higher."
		lineageTag: 369b7871-3cd2-418b-b1bc-be8017ac6bb1

	measure 'Headline completeness' =
			"ASIA grade and Spinal Trauma Score are empty. Charlson is filled for "
			    & FORMAT ( CALCULATE ( [Filled %], 'Completeness field'[Field] = "Charlson (CCI)" ), "0%" )
			    & " of admissions and ICD-10 codes for " & FORMAT ( CALCULATE ( [Filled %], 'Completeness field'[Field] = "ICD-10 code*" ), "0%" )
			    & ", so anything using them covers part of the cohort only."
		lineageTag: ac6a96a7-fb42-46a0-8f88-0aa484b5769a

	measure 'Deaths of admissions' = IF ( [Admissions (n)] = 0, BLANK (), FORMAT ( [Deaths (n)], "0" ) & " / " & FORMAT ( [Admissions (n)], "#,0" ) )
		lineageTag: 8b360392-4719-4464-baa2-7e6d1c819352

	measure 'Patients context' = FORMAT ( [Patients (n)], "#,0" ) & " patients"
		lineageTag: f61580bb-75ee-42ee-85a4-5a0caf444778

	measure 'Mortality context' = IF ( [Admissions (n)] = 0, BLANK (), FORMAT ( [Deaths (n)], "0" ) & " deaths, 95% CI " & FORMAT ( [Mortality CI lower %], "0.0%" ) & " to " & FORMAT ( [Mortality CI upper %], "0.0%" ) )
		lineageTag: b24423e8-9c34-438b-a084-e0de33f4c2b8

	measure 'LOS context' = "average " & FORMAT ( [Average length of stay (days)], "0.0" ) & " days"
		lineageTag: bc43999f-264d-422d-b5bf-3475c1237f69

	measure 'ICU context' = "of admissions with ICU hours recorded"
		lineageTag: 905fb5b7-1314-41f4-b8b7-5fdc0bbc5e54

	measure 'Cost context' = "fee-based estimate, not the full cost"
		lineageTag: d05dcb68-3da6-4ef0-a9e8-09e167b7c3e2

