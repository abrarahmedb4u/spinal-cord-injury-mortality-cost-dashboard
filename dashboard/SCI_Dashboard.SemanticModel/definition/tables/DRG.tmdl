		summarizeBy: none
		sourceColumn: AdmissionKey

		annotation SummarizationSetBy = Automatic

	partition DRG = m
		mode: import
		source =
				let
				    Source = REDCap_Raw,
				    Rows = Table.SelectRows(Source, each [redcap_repeat_instrument] = "drg"),
				    Keep = Table.SelectColumns(Rows, {"patient_id", "redcap_repeat_instance", "drg", "drg_description"}),
				    SingleAdm = Table.SelectColumns(Table.SelectRows(Admissions, each [#"Single-admission patient"] = true), {"patient_id", "AdmissionKey"}),
				    Joined = Table.NestedJoin(Keep, {"patient_id"}, SingleAdm, {"patient_id"}, "A", JoinKind.LeftOuter),
				    Final = Table.ExpandTableColumn(Joined, "A", {"AdmissionKey"})
				in
				    Final

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

