		annotation SummarizationSetBy = Automatic

	column redcap_repeat_instance
		dataType: string
		lineageTag: b4041f29-a381-4080-a339-4ac9fe68bbe6
		summarizeBy: none
		sourceColumn: redcap_repeat_instance

		annotation SummarizationSetBy = Automatic

	column drg
