	column 'Surgery fee'
		dataType: double
		lineageTag: 99067d19-913a-4f2a-99d2-b07c7cfd8964
		summarizeBy: sum
		sourceColumn: Surgery fee

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Fee match'
		dataType: string
		lineageTag: 52eaaa60-73a6-47c0-b2fd-cd3a3359e2db
		summarizeBy: none
		sourceColumn: Fee match

		annotation SummarizationSetBy = Automatic

	column 'Surgery fee (same-day discount)' =
			VAR pid = Surgery[patient_id]
			VAR d = Surgery[surg_date]
			VAR st = Surgery[Surgery status]
			VAR f = Surgery[Surgery fee]
			VAR inst = Surgery[redcap_repeat_instance]
			VAR rnk =
			    COUNTROWS (
			        FILTER (
			            Surgery,
			            Surgery[patient_id] = pid
			                && Surgery[surg_date] = d
			                && Surgery[Surgery status] = st
			                && ( Surgery[Surgery fee] > f
			                    || ( Surgery[Surgery fee] = f && Surgery[redcap_repeat_instance] < inst ) )
			        )
			    ) + 1
			RETURN
			    f * SWITCH ( TRUE (), rnk = 1, 1, rnk = 2, 0.5, 0.25 )
		formatString: \$#,0.00
		lineageTag: 77625d85-9d81-430f-a089-4592a4247b94
		summarizeBy: sum

	partition Surgery = m
		mode: import
		source =
				let
				    Source = REDCap_Raw,
				    Rows = Table.SelectRows(Source, each [redcap_repeat_instrument] = "surgery"),
				    Keep = Table.SelectColumns(Rows, {"patient_id", "redcap_repeat_instance", "surg_status", "surg_date", "surg_problem", "surg_achi", "surg_op_description"}),
				    Typed = Table.TransformColumnTypes(Keep, {{"redcap_repeat_instance", Int64.Type}, {"surg_date", type date}}),
				    Status = Table.AddColumn(Typed, "Surgery status", each if [surg_status] = "2" then "Actual" else if [surg_status] = "1" then "Planned" else "Unknown", type text),
				    Site = Table.AddColumn(Status, "Surgery site", each if [surg_problem] = "1" then "Lumbar" else if [surg_problem] = "2" then "Cervical" else "Not recorded", type text),
				    FeeMerge = Table.NestedJoin(Site, {"surg_achi"}, ACHI_MBS_Map, {"surg_achi"}, "M", JoinKind.LeftOuter),
				    FeeExpand = Table.ExpandTableColumn(FeeMerge, "M", {"MBS item", "MBS fee", "Match"}, {"MBS item", "Surgery fee", "Fee match"}),
				    SingleAdm = Table.SelectColumns(Table.SelectRows(Admissions, each [#"Single-admission patient"] = true), {"patient_id", "AdmissionKey"}),
				    Joined = Table.NestedJoin(FeeExpand, {"patient_id"}, SingleAdm, {"patient_id"}, "A", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "A", {"AdmissionKey"}),
				    Final = Table.RemoveColumns(Expanded, {"surg_status", "surg_problem"}),
				    Typed2 = Table.TransformColumnTypes(Final, {{"Surgery fee", type number}})
				in
				    Typed2

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

